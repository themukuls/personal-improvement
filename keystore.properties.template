# Release signing — copy to `keystore.properties` (git-ignored) and fill in.
# Generate a keystore once:
#   keytool -genkeypair -v -keystore chiefofstaff-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias chiefofstaff
#
# Then a signed release APK/AAB:
#   ./gradlew assembleRelease   # APK
#   ./gradlew bundleRelease     # AAB for Play Store
#
# With no keystore.properties present, `assembleRelease` still builds an
# unsigned, R8-shrunk APK (this is what CI does).

storeFile=chiefofstaff-release.jks
storePassword=CHANGE_ME
keyAlias=chiefofstaff
keyPassword=CHANGE_ME
